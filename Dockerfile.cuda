# NVIDIA CUDA image — for hosts with an NVIDIA GPU + the NVIDIA Container
# Toolkit installed (`docker run --gpus all ...` or the compose "gpu" profile).
# CUDA 12.1 runtime to match requirements-cuda.txt's torch==2.5.1+cu121 build.
FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

# python3: Ubuntu 22.04 ships 3.10. ffmpeg: audio conversion.
# libsndfile1: soundfile (speechbrain dep). libgomp1: OpenMP runtime. curl: healthcheck.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip ffmpeg libsndfile1 libgomp1 curl \
    && rm -rf /var/lib/apt/lists/*

# Non-root user whose home directory is the single persistence point:
# $HOME/.config/audio_transcriber (settings), $HOME/.cache (model downloads),
# $HOME/AudioTranscriptions (audio + SQLite DB) all live under /data.
RUN useradd --create-home --home-dir /data --shell /bin/bash appuser

WORKDIR /app

COPY requirements.txt requirements-cuda.txt ./
# Base requirements first, then override torch/torchaudio with the CUDA build
# — mirrors the native NVIDIA install steps documented in CLAUDE.md.
RUN python3 -m pip install --no-cache-dir -r requirements.txt \
    && python3 -m pip install --no-cache-dir -r requirements-cuda.txt

COPY . .

USER appuser
ENV HOME=/data
VOLUME /data

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://localhost:8000/ || exit 1

# Setup (storage dir, model size, download) happens through the browser
# wizard on first visit — same flow as a native install.
CMD ["python3", "run.py", "--no-browser", "--host", "0.0.0.0"]
